# ═══════════════════════════════════════════════════════════════════════════════
# KIPRAMP — Environment Variables Template
# Copy: cp .env.example .env  lalu isi semua nilai
# ═══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Dev SQLite  : DATABASE_URL="file:./prisma/dev.db"
# Prod (Neon) : DATABASE_URL="postgresql://user:pass@host/kipramp?sslmode=require"
DATABASE_URL=

# ─── KIPAY PAYMENT GATEWAY ────────────────────────────────────────────────────
# Docs: https://kipay.id/docs
# API base: https://api.kipay.id/api/pay
# Dapet API key dari dashboard KiPay (buat project sandbox dulu untuk testing).
#
# SERVER-SIDE SAJA. Jangan ada NEXT_PUBLIC_KIPAY_*, jangan printf/key di log,
# jangan masuk ke browser JS, HTML, prop React, analytics, atau error message.
#
# Variable yang dipakai app:
#   KIPAY_API_BASE_URL  = https://api.kipay.id/api/pay
#   KIPAY_API_KEY        = kunci project KiPay (server-only)
#   KIPAY_MODE           = sandbox | production
#
# Mode & kunci harus cocok:
#   KIPAY_MODE=sandbox    → gunakan kunci SANDBOX KiPay (trx_id SBX-...)
#   KIPAY_MODE=production → gunakan kunci PRODUCTION KiPay (trx_id QRIS-...)
# Jangan campur sandbox/production credential.
#
# Webhook situation (terkini):
# KiPay belum publish kontrak signature webhook publik.
# Sistem ini tidak reject webhook hanya karena tidak ada signature.
# Keamanan webhook: terima sinyal → lookup payment lokal → verifikasi
# server-to-server GETtransactions/{trxId} → cek status+amount → transisi atomik.
# Kalau nanti KiPay publish signature resmi, implement sesuai kontrak tersebut.
#
KIPAY_API_BASE_URL=https://api.kipay.id/api/pay
KIPAY_API_KEY=apg_your_project_key_here
KIPAY_MODE=sandbox
# Webhook signing secret — set dari dashboard KiPay setelah generate HMAC secret
# Format: string apapun (disarankan 32+ karakter random hex)
# Kosongkan untuk skip verifikasi (tidak disarankan di production)
KIPAY_WEBHOOK_SECRET=

# ─── ADMIN AUTH — Admin Access Key (64 hex characters) ──────────────────────
# Lihat & generate ulang key dari dashboard: /admin → Access Key.
# Atau via CLI (khusus recovery saat terkunci / belum bisa login):
#   npm run admin:setup
#
# ADMIN_ACCESS_KEY digunakan untuk:
# 1. Login ke dashboard admin (/admin/login)
# 2. Verifikasi signature webhook (jika digunakan)
#
# CATATAN:
# - Key adalah 64 karakter hex lowercase (contoh: 4e2f29df0e056ba992268f29dac96ccd4030c94a7f8cdfe1640ff0d77089ea53)
# - Key disimpan di database sebagai SHA-256 hash (tidak plaintext!)
# - Session setelah login pakai JWT di HttpOnly cookie
# - Tidak ada email/password/role untuk admin
#
# Generate key baru (butuh akses server / terkunci):
#   npm run admin:setup
#
# Key rotation:
# - Dari dashboard: /admin → Access Key → Generate Key Baru (tetap login)
# - Via CLI: npm run admin:setup (semua session lama langsung mati)
# - Pastikan tidak ada duplikasi key aktif
#
# Untuk testing lokal, generate key dulu:
#   npm run admin:setup
#
ADMIN_ACCESS_KEY=

# ─── JWT SESSION ───────────────────────────────────────────────────────────────
# Session JWT untuk admin setelah login. 10-min idle sliding expiration (P17).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
# 10m idle (jangan 24h). Absolute max 8h enforced in code.
ADMIN_SESSION_EXPIRES_IN=10m

# ─── ADMIN TOTP 2FA (faktor kedua, rotating) ─────────────────────────────────
# Kosongkan = mode kunci-saja (kompatibel lama). Isi = login wajib kode 6 digit.
# Generate: npm run admin:totp-setup  (JANGAN pakai secret contoh manapun)
# Step 30s (standar authenticator), toleransi ±1 langkah (~90s jendela entry).
# Hanya 1 device aktif: login baru menendang session lama + session terikat browser.
ADMIN_TOTP_SECRET=

# ─── ENV ADMIN MODE ────────────────────────────────────────────────────────────
# Jika true, tampilkan link login admin di footer/footer navbar.
# Jika false, sembunyikan (hanya untuk production).
ADMIN_DASHBOARD_VISIBLE=true

# ─── BLOCKCHAIN RPC ───────────────────────────────────────────────────────────
# Options: mock | real
BLOCKCHAIN_PROVIDER=real

# ── NETWORK MODE ───────────────────────────────────────────────────────────────
# Switch between testnet (development) and mainnet (production) by changing
# the RPC URLs and chain IDs below. Chain IDs must match the wagmi config.
#
# TESTNET (development / testing):
#   Solana Devnet     | Base Sepolia (chainId: 84532) | BSC Testnet (chainId: 97)
#
# MAINNET (production):
#   Solana Mainnet    | Base Mainnet (chainId: 8453)  | BSC Mainnet (chainId: 56)

# Solana cluster — 'mainnet' or 'devnet'
SOLANA_NETWORK=devnet

# ── Server-side RPC (backend: deposit polling, withdrawal) ────────────────────
# TESTNET:
SOLANA_RPC_URL=https://api.devnet.solana.com
BASE_RPC_URL=https://sepolia.base.org
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# MAINNET (uncomment for production):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BASE_RPC_URL=https://mainnet.base.org
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Client-side RPC (browser wallet connection) ───────────────────────────────
# TESTNET:
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# MAINNET (uncomment for production):
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Chain IDs ─────────────────────────────────────────────────────────────────
# TESTNET:
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BSC_CHAIN_ID=97
# MAINNET (uncomment for production):
# NEXT_PUBLIC_BASE_CHAIN_ID=8453
# NEXT_PUBLIC_BSC_CHAIN_ID=56

# ── Backend chain identity (§9) ──────────────────────────────────────────────
# Chain ID eksplisit yang DIVERIFIKASI via eth_chainId (fail closed).
# Harus cocok dengan RPC di atas. Default = testnet bila dikosongkan.
# BASE_CHAIN_ID=84532
# BSC_CHAIN_ID=97
# Mainnet: BASE_CHAIN_ID=8453 / BSC_CHAIN_ID=56

# ── Deposit history source per network (§12) ─────────────────────────────────
# alchemy | blockscout | block-scan (default: block-scan).
# - alchemy: butuh ALCHEMY_API_KEY + ALCHEMY_BASE_RPC_URL / ALCHEMY_BSC_RPC_URL
# - blockscout: indexer terbuka (hanya BASE; butuh BLOCKSCOUT_BASE_URL bila custom)
# - block-scan: bounded block scan, selalu tersedia sebagai fallback
# BASE_HISTORY_PROVIDER=block-scan
# BSC_HISTORY_PROVIDER=block-scan
# ALCHEMY_BASE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# BLOCKSCOUT_BASE_URL=https://base-sepolia.blockscout.com/api

# ─── PLATFORM WALLET PRIVATE KEYS ────────────────────────────────────────────
# ⚠ JANGAN commit nilai nyata ke Git!
# Gunakan Vercel Environment Variables untuk production.
# Gunakan KMS (AWS KMS / HashiCorp Vault) untuk custody yang aman.
SOLANA_PLATFORM_PRIVATE_KEY=
BASE_PLATFORM_PRIVATE_KEY=
BSC_PLATFORM_PRIVATE_KEY=

# ─── FYAS PPOB — Bank Transfer Disbursement ───────────────────────────────────
# Docs: https://ppob.fyas.my.id/docs#transfer-bank
# Register at https://ppob.fyas.my.id — API key auto-generated on register
FYAS_API_KEY=sk_your_fyas_api_key_here
FYAS_BASE_URL=https://ppob.fyas.my.id

# ─── PRICING ──────────────────────────────────────────────────────────────────
QUOTE_TTL_SECONDS=60
# Emergency hardcoded price fallback (P8). Default OFF — quotes STOP when
# live+manual+stale all unavailable. Set true only as explicit emergency mode.
MARKETPLACE_EMERGENCY_HARDCODED_PRICE=false

# ─── WEBHOOK ──────────────────────────────────────────────────────────────────
# KiPay webhook belum ada signature publik (lihat catatan di atas).
# Ini tidak dipakai untuk verifikasi signature — webhook di-verify server-to-server.
KIPAY_ALLOW_UNSIGNED=false

# ─── CRON ─────────────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (set in prod, Vercel Cron sends it).
CRON_SECRET=
# Optional production indexer for cheap EVM deposit lookup (P11).
# When set, scanner uses alchemy_getAssetTransfers instead of capped block-scan.
ALCHEMY_API_KEY=

# ─── ACTIVE DEFENSE (server-side only, never exposed) ─────────────────────────
# Escalation thresholds: cumulative failures per IP, rolling 24h (flags/alerts).
SECURITY_ESCALATION_L1=50
SECURITY_ESCALATION_L2=100
SECURITY_ESCALATION_L3=200
SECURITY_ESCALATION_L4=400
SECURITY_ESCALATION_L5=800
# First confirmed-violation ban triggers at this many rolling-24h failures.
SECURITY_FIRST_BAN_FAILURES=50
# Progressive temp bans: BAN #N lasts N hours. Capped — never infinite.
MAX_AUTOMATIC_BAN_HOURS=24
# Clean days without violations after which the cycle count decays to 0.
SECURITY_DECAY_CLEAN_DAYS=30
# Distributed detection: distinct failing IPs within window.
SECURITY_DISTINCT_IPS=10
SECURITY_DIST_WINDOW_MS=600000
# Retention for aggregated security events (days).
SECURITY_EVENT_RETENTION_DAYS=30
# Max API request body bytes (middleware early-reject 413).
MAX_REQUEST_BODY_SIZE=1048576
# Trusted proxy hops for client-IP extraction (0 = first X-Forwarded-For entry).
TRUSTED_PROXY_COUNT=0
# Webhook event max age seconds (fail closed on stale/future timestamps).
WEBHOOK_MAX_AGE_SEC=172800

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://kipramp.xyz

# WalletConnect Project ID — https://cloud.walletconnect.com
# Used by RainbowKit (EVM: MetaMask/Rabby/Coinbase/WalletConnect). Same Cloud ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_from_cloud_walletconnect_com
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BSC_CHAIN_ID=97
