generator client {
  provider = "prisma-client-js"
}

// Dev: SQLite  |  Prod (Vercel): PostgreSQL
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── WALLET-FIRST DESIGN ──────────────────────────────────────────────────────
// No "users" table for normal customers.
// Wallet address IS the customer identity.
// Orders belong to a wallet_address + network combination.

// ─── ASSETS & NETWORKS ───────────────────────────────────────────────────────

model Network {
  id          String   @id @default(uuid())
  networkId   String   @unique  // SOLANA | BASE | BSC
  name        String
  displayName String
  chainId     String?
  explorerUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  assets   Asset[]
  wallets  PlatformWallet[]
}

model Asset {
  id        String   @id @default(uuid())
  symbol    String   @unique  // SOL | ETH | BNB
  name      String
  decimals  Int
  isActive  Boolean  @default(true)
  networkId String
  createdAt DateTime @default(now())

  network     Network      @relation(fields: [networkId], references: [id])
  topUpOrders TopUpOrder[]
  sellOrders  SellOrder[]
  quotes      Quote[]
}

// ─── PLATFORM WALLETS (KIPRAMP hot wallets) ───────────────────────────────────

model PlatformWallet {
  id        String   @id @default(uuid())
  networkId String
  address   String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  network           Network            @relation(fields: [networkId], references: [id])
  cryptoDeposits    CryptoDeposit[]
  cryptoWithdrawals CryptoWithdrawal[]

  @@index([networkId])
}

// ─── QUOTES ───────────────────────────────────────────────────────────────────

model Quote {
  id           String    @id @default(uuid())
  type         String    // TOP_UP | SELL
  assetId      String
  assetSymbol  String
  network      String
  idrAmount    Decimal
  cryptoAmount Decimal
  marketPrice  Decimal
  spread       Decimal
  serviceFee   Decimal
  networkFee   Decimal
  tax          Decimal  @default(0)
  taxRate      Decimal  @default(0)
  totalIdr     Decimal
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  asset       Asset        @relation(fields: [assetId], references: [id])
  topUpOrders TopUpOrder[]
  sellOrders  SellOrder[]

  @@index([expiresAt])
  // Atomic quote consumption filters type + expiry (P9/P22).
  @@index([type, expiresAt])
}

// ─── TOP UP ORDERS ────────────────────────────────────────────────────────────

model TopUpOrder {
  id                 String    @id @default(uuid())
  publicId           String    @unique  // opaque public token e.g. "kst_abc123xyz"
  orderNumber        String    @unique  // human-readable e.g. "KSW-ABC123"
  // Wallet identity (no user account needed)
  walletAddress      String
  walletType         String    // EVM | SOLANA
  assetId            String
  assetSymbol        String
  network            String
  quoteId            String
  idrAmount          Decimal
  cryptoAmount       Decimal
  serviceFee         Decimal
  networkFee         Decimal
  tax                Decimal  @default(0)
  totalIdr           Decimal
  destinationAddress String    // = walletAddress (from connected wallet)
  status             String    @default("CREATED")
  failureReason      String?
  cryptoTxHash       String?
  completedAt        DateTime?
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset         Asset             @relation(fields: [assetId], references: [id])
  quote         Quote             @relation(fields: [quoteId], references: [id])
  payment       Payment?
  withdrawal    CryptoWithdrawal?
  ledgerEntries LedgerEntry[]

  @@index([walletAddress])
  @@index([status])
  // Admin list: WHERE status + ORDER BY createdAt (P22). Unique fields already indexed.
  @@index([status, createdAt])
  @@index([cryptoTxHash])
}

// ─── SELL ORDERS ──────────────────────────────────────────────────────────────

model SellOrder {
  id                    String    @id @default(uuid())
  publicId              String    @unique  // opaque public token
  orderNumber           String    @unique
  // Wallet identity
  walletAddress         String
  walletType            String    // EVM | SOLANA
  assetId               String
  assetSymbol           String
  network               String
  quoteId               String
  cryptoAmount          Decimal
  idrAmount             Decimal
  serviceFee            Decimal
  networkFee            Decimal
  tax                   Decimal  @default(0)
  totalIdrPayout        Decimal
  depositAddress        String    // KIPRAMP platform deposit address
  // Payout — stored per-transaction, no saved bank profile
  payoutBankName        String?
  payoutAccountNumber   String?
  payoutAccountName     String?
  status                String    @default("CREATED")
  failureReason         String?
  cryptoTxHash          String?
  confirmations         Int       @default(0)
  requiredConfirmations Int       @default(1)
  completedAt           DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  asset         Asset          @relation(fields: [assetId], references: [id])
  quote         Quote          @relation(fields: [quoteId], references: [id])
  payout        Payout?
  deposit       CryptoDeposit?
  ledgerEntries LedgerEntry[]

  @@index([walletAddress])
  @@index([status])
  // Admin list + cron scanner: WHERE status + ORDER BY createdAt (P22).
  @@index([status, createdAt])
  // txHash uniqueness check across sell orders (P10).
  @@index([cryptoTxHash])
}

// ─── PAYMENTS (Xendit — active provider) ──────────────────────────────────────

model Payment {
  id                    String    @id @default(uuid())
  topUpOrderId          String    @unique
  // Legacy KiPay fields (retired provider — columns kept, unused for new orders)
  kipayTrxId            String?   @unique  // e.g. "SBX-20260825-VG57V5"
  kipayMode             String?   // sandbox | production
  // Generic provider fields (active: xendit)
  // LEGACY values "transfi" / kipay channels may appear on historical rows only.
  provider              String?   // xendit (new orders)
  providerOrderId       String?   @unique  // Xendit payment_request_id (pr-...)
  providerStatus        String?   // last verified Xendit payment_request status
  providerChannel       String?   // e.g. QRIS
  payUrl                String?   // Xendit redirect action fallback (rare for QRIS)
  providerFee           Decimal?  // LEGACY provider fee snapshot (unused for new Xendit orders)
  providerRate          Decimal?  // LEGACY provider rate snapshot (unused for new Xendit orders)
  providerQuote         String?   // LEGACY JSON snapshot of provider quote (audit, unused for new orders)
  providerCreatedAt     DateTime?
  providerUpdatedAt     DateTime?
  requestedAmount       Decimal
  uniqueCode            Int?
  grossAmount           Decimal
  feeAmount             Decimal?
  netAmount             Decimal?
  currency              String    @default("IDR")
  status                String    @default("PENDING")  // PENDING | PAID | EXPIRED | FAILED
  qrPayload             String?   // raw QRIS string (Xendit actions QR_STRING)
  lastVerifiedAt        DateTime? // throttle verifikasi upstream (§13/§28)
  note                  String?
  paidAt                DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  topUpOrder TopUpOrder     @relation(fields: [topUpOrderId], references: [id])
  webhooks   KipayWebhook[]

  @@index([kipayTrxId])
  @@index([providerOrderId])
  @@index([status])
}

model TransfiWebhook {
  // LEGACY/DEPRECATED — TransFi retired. Rows kept for history only.
  // New orders MUST use XenditWebhook. Never write here for new orders.
  id          String    @id @default(uuid())
  paymentId   String?
  orderId     String    // TransFi OR-...
  eventId     String    // TransFi EV-... (idempotency key)
  status      String    // TransFi order status at event time
  payload     String    // raw JSON
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([orderId, eventId])
  @@index([orderId])
}

model KipayWebhook {
  // LEGACY/DEPRECATED — KiPay retired. Rows kept for history only.
  id          String    @id @default(uuid())
  paymentId   String?
  kipayTrxId  String
  eventType   String    // transaction.paid | transaction.expired
  payload     String    // raw JSON
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([kipayTrxId, eventType])
  @@index([kipayTrxId])
}

// ─── CRYPTO ───────────────────────────────────────────────────────────────────

model CryptoDeposit {
  id              String    @id @default(uuid())
  sellOrderId     String    @unique
  platformWalletId String
  txHash          String?
  network         String
  asset           String
  amount          Decimal
  senderAddress   String?
  confirmations   Int       @default(0)
  isConfirmed     Boolean   @default(false)
  detectedAt      DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellOrder      SellOrder      @relation(fields: [sellOrderId], references: [id])
  platformWallet PlatformWallet @relation(fields: [platformWalletId], references: [id])

  @@index([txHash])
  @@index([network])
}

model CryptoWithdrawal {
  id               String    @id @default(uuid())
  topUpOrderId     String    @unique
  platformWalletId String
  txHash           String?
  network          String
  asset            String
  amount           Decimal
  destination      String
  status           String    @default("PENDING")
  sentAt           DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  topUpOrder     TopUpOrder     @relation(fields: [topUpOrderId], references: [id])
  platformWallet PlatformWallet @relation(fields: [platformWalletId], references: [id])

  @@index([txHash])
}

// ─── PAYOUTS ──────────────────────────────────────────────────────────────────

model Payout {
  id            String    @id @default(uuid())
  sellOrderId   String    @unique
  bankName      String
  accountNumber String
  accountName   String
  amount        Decimal
  status        String    @default("PENDING")
  providerRef   String?
  // Xendit payout reconciliation (active provider = xendit)
  xenditPayoutId    String?   @unique
  idempotencyKey    String?   @unique
  xenditStatus      String?
  failureCode       String?
  failureReason String?
  sentAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sellOrder SellOrder @relation(fields: [sellOrderId], references: [id])

  @@index([status])
}

model XenditWebhook {
  id               String    @id @default(uuid())
  paymentId        String?
  payoutId         String?
  kind             String    // PAYMENT | PAYOUT
  event            String    // e.g. payment.capture, v3_payout.succeeded
  paymentRequestId String?
  xenditPayoutId   String?
  referenceId      String?
  status           String?
  payload          String    // raw JSON
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([kind, event, paymentRequestId, payoutId])
  @@index([referenceId])
  @@index([paymentRequestId])
  @@index([xenditPayoutId])
}

// ─── LEDGER ───────────────────────────────────────────────────────────────────

model LedgerEntry {
  id              String   @id @default(uuid())
  walletAddress   String
  asset           String   // IDR | SOL | ETH | BNB
  direction       String   // CREDIT | DEBIT
  amount          Decimal
  reference       String
  topUpOrderId    String?
  sellOrderId     String?
  description     String?
  createdAt       DateTime @default(now())

  topUpOrder TopUpOrder? @relation(fields: [topUpOrderId], references: [id])
  sellOrder  SellOrder?  @relation(fields: [sellOrderId], references: [id])

  @@index([walletAddress])
  @@index([topUpOrderId])
  @@index([sellOrderId])
}

// ─── AUDIT & SYSTEM ───────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  actor     String?  // walletAddress | admin email | "system"
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actor])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model FeeConfig {
  id             String   @id @default(uuid())
  assetSymbol    String
  type           String   // TOP_UP | SELL
  serviceFeeRate Decimal
  networkFeeRate Decimal  @default(0) // % dari bruto, cth 0.001 = 0.1%
  taxRate        Decimal  @default(0) // % dari bruto, cth 0.001 = 0.1%
  minOrderIdr    Decimal
  maxOrderIdr    Decimal
  // SOL ATA fee dalam satuan SOL (bukan IDR!) — dipotong langsung dari crypto output
  // saat Top Up SOL. Contoh: 0.002 = potong 0.002 SOL dari SOL yang diterima user.
  // Ini menutupi biaya pembuatan ATA jika wallet penerima belum punya ATA.
  // Default 0 = tidak dipotong. Nama kolom DB tetap solAtaFeeIdr (backward compat).
  solAtaFeeIdr   Decimal  @default(0)
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@unique([assetSymbol, type])
}

// ─── ACTIVE DEFENSE (security events + IP bans, aggregated/deduped) ──────────
// One row per (hour bucket, ip, eventType) with counters — repeated identical
// events bump counters, never create unbounded rows (see SECURITY_EVENT_RETENTION).

model SecurityEvent {
  id          String   @id @default(uuid())
  bucket      DateTime // hour bucket (UTC) for aggregation/dedup
  ip          String
  subnet      String?  // /24 (IPv4) — never treat IP as perfect identity
  fingerprint String?  // hash(ip + UA) — correlates botnets across rotating IPs
  eventType   String   // ADMIN_LOGIN_FAIL | WEBHOOK_INVALID_SIG | RATE_LIMITED | FLOOD | ...
  severity    String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  endpoint    String?
  userAgent   String?
  country     String?  // approximate only (from trusted proxy headers), never exact
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @updatedAt
  actionTaken String?  // NONE | RATE_LIMITED | QUARANTINED | BLOCKED

  @@unique([bucket, ip, eventType])
  @@index([ip])
  @@index([severity, lastSeen])
  @@index([eventType, lastSeen])
}

model IpBan {
  id        String    @id @default(uuid())
  ip        String    @unique
  // Public restriction ID (safe to show; random, reveals nothing internal).
  publicId  String    @unique @default(uuid())
  reason    String
  // Progressive temp-ban state: BAN #N lasts N hours, capped at max auto.
  level     Int       @default(1) // escalation display level
  violationCount Int  @default(1) // imposed ban cycles (server-computed)
  requestCount   Int  @default(0) // blocked hits during bans (display only)
  durationMs     Int  @default(3600000) // imposed duration, server-computed
  expiresAt DateTime? // null + permanent=true = explicit MANUAL permanent only
  permanent Boolean   @default(false) // only ever set manually by admin
  needsReview Boolean @default(false) // set when cycles exceed the auto cap
  eventRef  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([expiresAt])
}

// ─── WEB ANALYTICS (privacy-preserving page views) ──────────────────────────
// No IP / user-agent / fingerprint — path + UTC day only. One row per
// (path, day) with a counter, so traffic never creates unbounded rows.

model PageVisit {
  id        String   @id @default(uuid())
  path      String
  day       DateTime // UTC midnight — daily aggregation bucket
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([path, day])
  @@index([day])
}

// ─── ADMIN ACCESS KEY (SEPARATE FROM CUSTOMER FLOW) ────────────────────────
// Single credential system — no email, no password, no role hierarchy.
// Admin Access Key = 64-char hex, stored only as SHA-256 verifier.
// Login dengan key → session token (cookie) → full dashboard access.

model AdminAccessKey {
  id                 String   @id @default(uuid())
  keyVerifier        String   @unique  // SHA-256 of the access key (stored, not plaintext)
  isActive           Boolean  @default(true)
  keyVersion         Int      @default(1)  // untuk key rotation
  // Single-device enforcement: only the newest session (jti) is valid.
  // New login overwrites this and kicks the previous device.
  activeSessionJti   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastLoginAt        DateTime?  // tracking, bukan keamanan

  @@index([keyVerifier])
  @@index([isActive])
}

// ─── SUPPORT TICKETS (user → admin) ─────────────────────────────────────────
// Minimal ticket system for the wallet-sidebar support flow.
// Wallet address IS the reporter identity (wallet-first design, no users table).
// Only public context is stored — never seed phrases / private keys.
// Conversation lives in SupportMessage (backfilled from legacy `message`).

model SupportTicket {
  id            String    @id @default(uuid())
  publicId      String    @unique @default(uuid()) // opaque ticket ref shown to user
  subject       String
  message       String
  walletAddress String
  walletType    String    // EVM | SOLANA
  // Optional related KIPRAMP order (public IDs only, never internal DB IDs).
  orderPublicId String?
  orderSide     String?   // TOP_UP | SELL
  orderStatus   String?   // status snapshot at report time
  txHash        String?
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_CUSTOMER | RESOLVED | CLOSED
  adminNote     String?
  lastMessageAt DateTime? // updated on every message for inbox sorting
  adminUnread   Int       @default(0) // messages from CUSTOMER not yet seen by admin
  customerUnread Int      @default(0) // messages from ADMIN not yet seen by customer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      SupportMessage[]

  @@index([walletAddress])
  @@index([status, createdAt])
  @@index([orderPublicId])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String
  senderType String   // CUSTOMER | ADMIN
  message    String
  readAt     DateTime? // set when the *recipient* side opens the conversation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─── WALLET CHALLENGES (proof-of-ownership, single-use) ───────────────────
// DB-backed (never in-memory): Next.js bundles routes separately, so module
// state is NOT shared across /challenge and /verify in production. Single-use
// enforced atomically (updateMany WHERE usedAt IS NULL), like Quote consumption.

model WalletChallenge {
  id            String    @id @default(uuid())
  walletAddress String
  ecosystem     String    // EVM | SOLANA
  purpose       String    // REWARD_CLAIM | SUPPORT
  nonce         String
  message       String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

// ─── REWARDS (transaction-based promotional program) ──────────────────────
// Phase 2: eligibility/progress/claim-reservation only. NO payout —
// no treasury access, no signing, no transfers. Claims stay PENDING_PAYOUT.

model RewardConfig {
  id                  String    @id @default("default") // singleton row
  enabled             Boolean   @default(true)
  minTransactionIdr   Int       @default(100000)
  requiredCount       Int       @default(50)
  rewardMinUsd        Decimal   @default(1)
  rewardMaxUsd        Decimal   @default(2)
  cycle               String    @default("monthly")
  activeFrom          DateTime?
  networks            String    @default("SOLANA,BNB,BASE") // CSV allowlist
  termsVersion        String    @default("2026-09-v1")
  updatedAt           DateTime  @updatedAt
}

model RewardCycle {
  id             String   @id // "2026-09" (UTC month)
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("ACTIVE")
  configSnapshot String   // JSON snapshot of RewardConfig at cycle creation
  createdAt      DateTime @default(now())

  claims RewardClaim[]
}

model RewardClaim {
  id              String   @id @default(uuid())
  publicId        String   @unique @default(uuid())
  walletAddress   String
  cycleId         String
  qualifyingCount Int
  configSnapshot  String   // JSON snapshot (min, count, usd range, cycle, terms)
  rewardUsd       Decimal  // server-generated reservation, NOT a payout
  network         String
  destWallet      String
  policyVersion   String
  status          String   @default("PENDING_PAYOUT") // PENDING_PAYOUT | PROCESSING | SUBMITTED | CONFIRMING | PAID | DRY_RUN | UNDER_REVIEW | REJECTED | FAILED
  reviewReason    String?
  dryRunResult    String?  // JSON dry-run summary (no tx hash — nothing broadcast)
  // Live payout quote (fixed at PROCESSING, never recalculated on retry).
  token           String?  // canonical asset paid, e.g. SOL | BNB | ETH
  tokenAmount     String?
  baseUnits       String?
  rateUsd         String?
  rateSource      String?
  rateTimestamp   DateTime?
  txHash          String?  // real chain signature/hash only, never fake
  failureReason   String?
  attemptCount    Int      @default(0)
  submittedAt     DateTime?
  confirmedAt     DateTime?
  termsAcceptedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cycle RewardCycle @relation(fields: [cycleId], references: [id])

  @@unique([walletAddress, cycleId]) // one claim per wallet per cycle
  @@index([cycleId, status])
}
